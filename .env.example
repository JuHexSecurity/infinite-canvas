# Private deployment (keep the real .env file out of Git).
PRIVATE_DEPLOYMENT=true
AI_GATEWAY_URL=/api/ai
AI_GATEWAY_PORT=8787
AI_UPSTREAM_API_FORMAT=openai
AI_UPSTREAM_BASE_URL=https://api.example.com
AI_UPSTREAM_API_KEY=replace-with-a-secret
# Only needed when the browser calls an absolute gateway URL. Prefer the exact browser origin in production.
AI_CORS_ORIGIN=http://localhost:3000

# Optional analytics for the public/browser-only mode.
# ANALYTICS_GA4_ID=
# ANALYTICS_BAIDU_ID=
